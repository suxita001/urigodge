rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================= Identity helpers =======================

    // Must match SUPER_ADMIN_EMAIL in src/utils/roles.ts and in storage.rules.
    function superAdminEmail() {
      return 'nikasuxita96@gmail.com';
    }

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function authEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function emailVerified() {
      return request.auth.token.get('email_verified', false) == true;
    }

    // The super admin is identified by the *verified* email in the Auth token, never by a
    // Firestore field, so no client write can grant or remove it.
    function isSuperAdmin() {
      return signedIn() && authEmail() == superAdminEmail() && emailVerified();
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function myDoc() {
      return get(userPath(request.auth.uid));
    }

    function isActive() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && myDoc().data.get('status', 'active') == 'active';
    }

    function hasRole(r) {
      return isActive() && myDoc().data.role == r;
    }

    function isAdmin() {
      return isSuperAdmin() || hasRole('admin');
    }

    function isManager() {
      return hasRole('restaurant_manager');
    }

    function managedIds() {
      return myDoc().data.get('managedRestaurantIds', []);
    }

    function managesRestaurant(rid) {
      return isManager() && rid in managedIds();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 80;
    }

    function isProtected(data) {
      return data.role == 'super_admin' || data.get('email', '').lower() == superAdminEmail();
    }

    function invitationPath() {
      return /databases/$(database)/documents/invitations/$(authEmail());
    }

    // ======================= Users =======================
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Self-registration. Role is always 'user' (or 'super_admin' for the verified super admin email).
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'status', 'managedRestaurantIds', 'createdAt', 'lastActiveAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && validName(request.resource.data.name)
        && request.resource.data.status == 'active'
        && request.resource.data.managedRestaurantIds == []
        && request.resource.data.createdAt == request.time
        && (!('lastActiveAt' in request.resource.data) || request.resource.data.lastActiveAt == request.time)
        && (request.resource.data.role == 'user' || (request.resource.data.role == 'super_admin' && isSuperAdmin()));

      // Users edit their own basic profile only. Role, status, email and assignments are off-limits.
      allow update: if isSelf(uid)
        && changedKeys().hasOnly(['name', 'phone', 'updatedAt', 'lastActiveAt'])
        && validName(request.resource.data.name)
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30));

      // The verified super admin email may mark its own document as super_admin.
      allow update: if isSelf(uid) && isSuperAdmin()
        && changedKeys().hasOnly(['role', 'status', 'managedRestaurantIds', 'updatedAt'])
        && request.resource.data.role == 'super_admin'
        && request.resource.data.status == 'active';

      // Claiming a pending invitation: only with a verified email that matches the invitation,
      // and only to exactly the role / restaurants the invitation grants.
      allow update: if isSelf(uid) && emailVerified()
        && resource.data.role in ['user', 'restaurant_manager']
        && resource.data.get('status', 'active') == 'active'
        && changedKeys().hasOnly(['role', 'managedRestaurantIds', 'updatedAt'])
        && exists(invitationPath())
        && get(invitationPath()).data.status == 'pending'
        && request.resource.data.role == get(invitationPath()).data.role
        && request.resource.data.managedRestaurantIds == get(invitationPath()).data.restaurantIds;

      // Admin management of other accounts. Only the super admin can grant/revoke 'admin' or edit admins.
      // Nobody can edit the super admin or assign 'super_admin'.
      allow update: if isAdmin() && !isSelf(uid)
        && !isProtected(resource.data)
        && changedKeys().hasOnly(['name', 'phone', 'role', 'managedRestaurantIds', 'status', 'updatedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.role in ['user', 'restaurant_manager', 'admin']
        && request.resource.data.status in ['active', 'blocked']
        && request.resource.data.managedRestaurantIds is list
        && (isSuperAdmin()
            || (resource.data.role in ['user', 'restaurant_manager']
                && request.resource.data.role in ['user', 'restaurant_manager']));

      allow delete: if isSuperAdmin() && !isProtected(resource.data);

      match /favorites/{restaurantId} {
        allow read: if isSelf(uid);
        allow delete: if isSelf(uid);
        allow create, update: if isSelf(uid) && isActive()
          && restaurantId.size() <= 128
          && request.resource.data.keys().hasOnly(['restaurantId', 'createdAt'])
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.createdAt == request.time;
      }
    }

    // ======================= Invitations (doc ID = lowercase email) =======================
    match /invitations/{email} {
      allow read: if isAdmin() || (signedIn() && authEmail() == email);

      allow create, update: if isAdmin()
        && email == email.lower()
        && email != superAdminEmail()
        && request.resource.data.email == email
        && request.resource.data.status == 'pending'
        && request.resource.data.restaurantIds is list
        && (request.resource.data.role == 'restaurant_manager'
            || (request.resource.data.role == 'admin' && isSuperAdmin()))
        && (resource == null || resource.data.role != 'admin' || isSuperAdmin());

      // The invitee marks their own invitation as accepted (in the same batch as the role claim).
      allow update: if signedIn() && emailVerified() && authEmail() == email
        && resource.data.status == 'pending'
        && changedKeys().hasOnly(['status', 'acceptedAt', 'acceptedUid'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedUid == request.auth.uid
        && request.resource.data.acceptedAt == request.time;

      allow delete: if isAdmin() && (resource.data.role != 'admin' || isSuperAdmin());
    }

    // ======================= Restaurants =======================
    match /restaurants/{rid} {
      allow get: if resource.data.get('status', 'published') == 'published' || isAdmin() || managesRestaurant(rid);
      // Public list queries must filter on status == 'published'.
      allow list: if resource.data.status == 'published' || isAdmin();

      allow create: if isAdmin()
        && request.resource.data.slug == rid
        && request.resource.data.status in ['published', 'draft'];

      allow update: if isAdmin()
        && request.resource.data.slug == rid
        && request.resource.data.status in ['published', 'draft'];

      // Managers edit content of their own restaurants but not identity/visibility fields.
      allow update: if managesRestaurant(rid)
        && !changedKeys().hasAny(['slug', 'status', 'createdAt', 'createdBy', 'popularity', 'home']);

      allow delete: if isAdmin();
    }

    // ======================= Activity logs (append-only) =======================
    match /activityLogs/{logId} {
      allow read: if isAdmin() || (isManager() && resource.data.restaurantId in managedIds());

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['actorUid', 'actorName', 'actorEmail', 'action', 'category', 'targetType', 'targetId', 'targetName', 'restaurantId', 'description', 'timestamp'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.get('email', '')
        && request.resource.data.timestamp == request.time
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && (request.resource.data.action in ['USER_REGISTERED', 'LOGIN', 'LOGOUT', 'INVITATION_ACCEPTED']
            || isAdmin()
            || (isManager() && request.resource.data.get('restaurantId', '') in managedIds()));

      allow update, delete: if false;
    }

    // ======================= Visit counter (doc ID = YYYY-MM-DD) =======================
    // Anyone may add exactly one view (and at most one visitor) per write; nothing else can change.
    match /analytics/{day} {
      allow read: if isAdmin();

      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['day', 'views', 'visitors'])
        && request.resource.data.day == day
        && request.resource.data.views == 1
        && request.resource.data.get('visitors', 0) in [0, 1];

      allow update: if changedKeys().hasOnly(['views', 'visitors'])
        && request.resource.data.views == resource.data.views + 1
        && (request.resource.data.get('visitors', 0) - resource.data.get('visitors', 0)) in [0, 1];

      allow delete: if false;
    }

    // ======================= Site settings =======================
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ======================= Everything else is closed =======================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
